# ---------------------------------------------------------------------------
# OS LESADOS — configuração de fornecedores de geração de imagem
# Escolhe UM fornecedor: gemini | openai | huggingface
# (também dá para forçar por pedido com o campo "provider" no JSON)
# ---------------------------------------------------------------------------
IMAGE_PROVIDER=gemini

PORT=8787
IMAGE_SIZE=1K

# Google Gemini (Nano Banana) — https://aistudio.google.com/
GEMINI_API_KEY=replace_with_your_real_key_here

# OpenAI (gpt-image-1 com refs / text-to-image 1536x1024) — https://platform.openai.com/api-keys
OPENAI_API_KEY=replace_with_your_real_key_here
OPENAI_IMAGE_MODEL=gpt-image-1
# Qualidade gpt-image: low|medium|high (default medium; só gpt-image-*)

# Hugging Face (Inference API; token opcional mas recomendado) — https://huggingface.co/settings/tokens
HF_TOKEN=replace_with_your_real_token_here
HF_IMAGE_MODEL=stabilityai/stable-diffusion-xl-base-1.0

# Cloudflare Workers AI (token + Account ID do dashboard) — https://dash.cloudflare.com/
CF_AI_TOKEN=replace_with_your_real_token_here
CF_ACCOUNT_ID=replace_with_your_account_id
CF_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell

# Texto narrativo (router: openai > anthropic > gemini; em falha tenta o seguinte)
# TEXT_PROVIDER=auto (default) | openai | anthropic | gemini
TEXT_PROVIDER=auto
TEXT_MODEL=gemini-2.5-flash
TEXT_OPENAI_MODEL=gpt-4o-mini
TEXT_ANTHROPIC_MODEL=claude-haiku-4-5
TEXT_MAX_TOKENS=8192
GEMINI_API_KEYS=chave_extra_1,chave_extra_2

# Anthropic Claude (texto) — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=replace_with_your_real_key_here
